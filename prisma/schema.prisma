// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ───────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  VOLUNTEER
}

enum RequestStatus {
  NEW
  FULFILLED
  CONTACTED
  UNCLAIMED
  REDISTRIBUTED
}

enum ItemCategory {
  CLOTHING
  GEAR
  CURATED_BAG
}

enum VolunteerSignupSource {
  PUBLIC
  ADMIN
}

/**
 * How a contact first reached us. Later activity comes from joined tables.
 */
enum ContactSource {
  INTERNAL
  EVENT
  REQUEST
}

// ─── Models ──────────────────────────────────────────────

model ItemType {
  id           String        @id @default(uuid())
  name         String        @unique
  category     ItemCategory
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  isDeleted    Boolean       @default(false)
  requestItems RequestItem[]
}

model Contact {
  id                 String              @id @default(uuid())
  name               String
  phone              String
  email              String?
  /**
   * Set once at creation; never overwritten by later activity.
   */
  source             ContactSource
  /**
   * e.g. event slug "fall-2026"; null when not applicable.
   */
  sourceDetail       String?             @db.VarChar(60)
  userProfileId      String?             @unique
  userProfile        UserProfile?        @relation(fields: [userProfileId], references: [id])
  requests           Request[]
  volunteerSignups   VolunteerSignup[]
  earlyAccessSignups EarlyAccessSignup[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  isDeleted          Boolean             @default(false)
}

model UserProfile {
  id               String    @id @default(uuid())
  supabaseUserId   String    @unique
  role             Role      @default(VOLUNTEER)
  contact          Contact?
  assignedRequests Request[] @relation("AssignedTo")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  isDeleted        Boolean   @default(false)
}

model Request {
  id             String        @id @default(uuid())
  contactId      String
  contact        Contact       @relation(fields: [contactId], references: [id])
  status         RequestStatus @default(NEW)
  /**
   * Free-text assignee label (max 100 chars); distinct from assignedTo (volunteer profile).
   */
  assignee       String?       @db.VarChar(100)
  additionalInfo String?
  assignedToId   String?
  assignedTo     UserProfile?  @relation("AssignedTo", fields: [assignedToId], references: [id])
  items          RequestItem[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  isDeleted      Boolean       @default(false)
}

model RequestItem {
  id         String   @id @default(uuid())
  requestId  String
  request    Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  itemTypeId String
  itemType   ItemType @relation(fields: [itemTypeId], references: [id])
  size       String? // null for gear items
  gender     String? // null for gear items
  quantity   Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  isDeleted  Boolean  @default(false)
}

model VolunteerSlot {
  id        String            @id @default(uuid())
  /**
   * Event label shown to the public, e.g. "Harvestfest - Clean Up".
   */
  title     String            @db.VarChar(120)
  startsAt  DateTime
  endsAt    DateTime
  capacity  Int
  signups   VolunteerSignup[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  isDeleted Boolean           @default(false)
}

model VolunteerSignup {
  id        String                @id @default(uuid())
  slotId    String
  slot      VolunteerSlot         @relation(fields: [slotId], references: [id])
  contactId String
  contact   Contact               @relation(fields: [contactId], references: [id])
  source    VolunteerSignupSource @default(PUBLIC)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  isDeleted Boolean               @default(false)

  @@unique([slotId, contactId])
}

model EarlyAccessSignup {
  id              String   @id @default(uuid())
  /**
   * Slug from src/data/earlyAccess.ts, e.g. "fall-2026".
   */
  eventSlug       String   @db.VarChar(60)
  contactId       String
  contact         Contact  @relation(fields: [contactId], references: [id])
  /**
   * Preferred early access day (YYYY-MM-DD, Eastern Time); null means either day.
   */
  preferredDayKey String?  @db.VarChar(10)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  isDeleted       Boolean  @default(false)

  @@unique([eventSlug, contactId])
}
